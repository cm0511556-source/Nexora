<?php
declare(strict_types=1);

require_once dirname(__DIR__, 2) . '/config/config.php';
require_once BASE_PATH . '/app/Database.php';
require_once BASE_PATH . '/app/Auth.php';

use VibrantHub\Auth;
use VibrantHub\Database;

Auth::requireAdmin();

$db = Database::connection();

$shipmentId = filter_input(INPUT_GET, 'id', FILTER_VALIDATE_INT);

if (!$shipmentId) {
    http_response_code(400);
    exit('Invalid shipment ID.');
}

$stmt = $db->prepare('SELECT * FROM shipments WHERE id = :id LIMIT 1');
$stmt->execute(['id' => $shipmentId]);
$shipment = $stmt->fetch();

if (!$shipment) {
    http_response_code(404);
    exit('Shipment not found.');
}

$waypointStmt = $db->prepare(
    'SELECT * FROM shipment_waypoints
     WHERE shipment_id = :shipment_id
     ORDER BY sequence ASC'
);
$waypointStmt->execute(['shipment_id' => $shipmentId]);
$waypoints = $waypointStmt->fetchAll();

$controlStmt = $db->prepare(
    'SELECT * FROM tracking_controls
     WHERE shipment_id = :shipment_id
     LIMIT 1'
);
$controlStmt->execute(['shipment_id' => $shipmentId]);
$control = $controlStmt->fetch();

if (!$control) {
    $insertControl = $db->prepare(
        'INSERT INTO tracking_controls
        (shipment_id, is_running, control_speed, tracking_mode)
        VALUES (:shipment_id, 0, :speed, :mode)'
    );

    $insertControl->execute([
        'shipment_id' => $shipmentId,
        'speed' => (float) $shipment['speed'],
        'mode' => (string) $shipment['tracking_mode'],
    ]);

    $controlStmt->execute(['shipment_id' => $shipmentId]);
    $control = $controlStmt->fetch();
}

function transportIcon(string $type): string
{
    return match (strtolower($type)) {
        'airplane', 'plane', 'air' => '✈️',
        'ship', 'ocean', 'sea' => '🚢',
        'train', 'rail' => '🚆',
        default => '🚚',
    };
}

function statusClass(string $status): string
{
    return match (strtolower($status)) {
        'delivered', 'completed' => 'success',
        'in_transit', 'moving' => 'info',
        'on_hold', 'held', 'paused' => 'warning',
        'cancelled', 'failed' => 'danger',
        default => 'muted',
    };
}

$icon = transportIcon((string) $shipment['transport_type']);
$status = (string) $shipment['status'];
$isRunning = (int) $control['is_running'] === 1;

function e2(mixed $value): string
{
    return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8');
}
?>
