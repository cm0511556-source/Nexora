<?php
declare(strict_types=1);

namespace VibrantHub\Tracking;

use PDO;
use RuntimeException;

final class Engine
{
    private const EARTH_RADIUS_KM = 6371.0088;

    public function __construct(private PDO $db)
    {
    }

    public function tick(int $shipmentId): array
    {
        $shipment = $this->getShipment($shipmentId);

        if (!$shipment) {
            throw new RuntimeException('Shipment not found.');
        }

        $control = $this->getControl($shipmentId);

        if (!$control || (int)$control['is_running'] !== 1) {
            return $this->state($shipmentId);
        }

        $holdCheck = $this->db->prepare("SELECT id FROM shipment_holds WHERE shipment_id = :id AND status = 'active' AND mandatory = 1 LIMIT 1");
        $holdCheck->execute([":id" => $shipmentId]);
        if ($holdCheck->fetchColumn()) {
            return $this->state($shipmentId);
        }

        $speed = max(0.0, (float)$control['control_speed']);

        if ($speed <= 0) {
            return $this->state($shipmentId);
        }

        $now = microtime(true);

        $lastUpdate = $shipment['last_update']
            ? strtotime((string)$shipment['last_update'])
            : null;

        if ($lastUpdate === false || $lastUpdate === null) {
            $elapsedSeconds = 1.0;
        } else {
            $elapsedSeconds = max(0.1, min(60.0, time() - $lastUpdate));
        }

        $distanceKm = ($speed * $elapsedSeconds) / 3600.0;

        $nextWaypoint = $this->getNextWaypoint($shipmentId, $control);

        $targetLat = $nextWaypoint
            ? (float)$nextWaypoint['latitude']
            : (float)$shipment['destination_lat'];

        $targetLng = $nextWaypoint
            ? (float)$nextWaypoint['longitude']
            : (float)$shipment['destination_lng'];

        $currentLat = (float)$shipment['current_lat'];
        $currentLng = (float)$shipment['current_lng'];

        $remainingToTarget = $this->distanceKm(
            $currentLat,
            $currentLng,
            $targetLat,
            $targetLng
        );

        $routeMove = $this->moveAlongStoredRoute(
            $shipment,
            $control,
            $nextWaypoint,
            $distanceKm
        );

        if ($routeMove !== null && $routeMove['at_target']) {
            return $this->arriveAtTarget(
                $shipment,
                $control,
                $nextWaypoint
            );
        }

        if ($routeMove !== null) {
            $newLat = $routeMove['lat'];
            $newLng = $routeMove['lng'];
            $heading = $routeMove['heading'];
            $totalDistance = $routeMove['total'];
            $travelled = $routeMove['travelled'];
            $remaining = $routeMove['remaining'];
            $newRouteSequence = $routeMove['route_sequence'];
        } else {
            if ($remainingToTarget <= 0.01 || $distanceKm >= $remainingToTarget) {
                return $this->arriveAtTarget(
                    $shipment,
                    $control,
                    $nextWaypoint
                );
            }

            $fraction = min(1.0, $distanceKm / $remainingToTarget);
            $angularDistance = $remainingToTarget / self::EARTH_RADIUS_KM;
            $bearingRad = deg2rad($this->bearing($currentLat, $currentLng, $targetLat, $targetLng));
            $latRad = deg2rad($currentLat);
            $lngRad = deg2rad($currentLng);
            $step = $angularDistance * $fraction;
            $newLatRad = asin(
                sin($latRad) * cos($step)
                + cos($latRad) * sin($step) * cos($bearingRad)
            );
            $newLngRad = $lngRad + atan2(
                sin($bearingRad) * sin($step) * cos($latRad),
                cos($step) - sin($latRad) * sin($newLatRad)
            );
            $newLat = rad2deg($newLatRad);
            $newLng = fmod(rad2deg($newLngRad) + 540.0, 360.0) - 180.0;

            $heading = $this->bearing(
                $currentLat,
                $currentLng,
                $newLat,
                $newLng
            );

            $totalDistance = $this->distanceKm(
                (float)$shipment['origin_lat'],
                (float)$shipment['origin_lng'],
                (float)$shipment['destination_lat'],
                (float)$shipment['destination_lng']
            );

            $travelled = $this->distanceKm(
                (float)$shipment['origin_lat'],
                (float)$shipment['origin_lng'],
                $newLat,
                $newLng
            );

            $remaining = max(0.0, $totalDistance - $travelled);
            $newRouteSequence = null;
        }

        $etaSeconds = $speed > 0
            ? ($remaining / $speed) * 3600
            : 0;

        $eta = date(
            'Y-m-d H:i:s',
            time() + (int)round($etaSeconds)
        );

        $this->db->beginTransaction();

        try {
            $stmt = $this->db->prepare(
                'UPDATE shipments
                 SET current_lat = :lat,
                     current_lng = :lng,
                     speed = :speed,
                     distance_total = :total,
                     distance_travelled = :travelled,
                     distance_remaining = :remaining,
                     eta = :eta,
                     status = :status,
                     tracking_mode = :mode,
                     last_update = CURRENT_TIMESTAMP,
                     updated_at = CURRENT_TIMESTAMP
                 WHERE id = :id'
            );

            $stmt->execute([
                ':lat' => $newLat,
                ':lng' => $newLng,
                ':speed' => $speed,
                ':total' => $totalDistance,
                ':travelled' => $travelled,
                ':remaining' => $remaining,
                ':eta' => $eta,
                ':status' => 'in_transit',
                ':mode' => $control['tracking_mode'] ?: 'simulation',
                ':id' => $shipmentId,
            ]);

            $position = $this->db->prepare(
                'INSERT INTO tracking_positions
                 (shipment_id, latitude, longitude, speed, heading)
                 VALUES
                 (:shipment_id, :lat, :lng, :speed, :heading)'
            );

            $position->execute([
                ':shipment_id' => $shipmentId,
                ':lat' => $newLat,
                ':lng' => $newLng,
                ':speed' => $speed,
                ':heading' => $heading,
            ]);

            if ($newRouteSequence !== null) {
                $cursorStmt = $this->db->prepare(
                    'UPDATE tracking_controls
                     SET current_route_sequence = :seq,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                );
                $cursorStmt->execute([
                    ':seq' => $newRouteSequence,
                    ':shipment_id' => $shipmentId,
                ]);
            }

            $this->db->commit();
        } catch (\Throwable $e) {
            if ($this->db->inTransaction()) {
                $this->db->rollBack();
            }

            throw $e;
        }

        return $this->state($shipmentId);
    }

    /**
     * Move along stored route geometry without changing the database.
     * Returns null when no usable route exists, allowing legacy movement.
     */
    private function moveAlongStoredRoute(
        array $shipment,
        array $control,
        ?array $nextWaypoint,
        float $distanceKm
    ): ?array {
        $stmt = $this->db->prepare(
            'SELECT sequence, latitude, longitude, waypoint_id
             FROM shipment_route_points
             WHERE shipment_id = :id
             ORDER BY sequence ASC'
        );
        $stmt->execute([':id' => (int)$shipment['id']]);
        $points = $stmt->fetchAll(PDO::FETCH_ASSOC);

        if (count($points) < 2) {
            return null;
        }

        $cursor = (int)($control['current_route_sequence'] ?? 0);
        $startIndex = 0;

        foreach ($points as $i => $point) {
            if ((int)$point['sequence'] >= $cursor) {
                $startIndex = $i;
                break;
            }
            if ($i === count($points) - 1) {
                return null;
            }
        }

        // Never skip the active operational waypoint.
        $endIndex = count($points) - 1;
        if ($nextWaypoint !== null) {
            $waypointId = (int)$nextWaypoint['id'];
            $found = false;
            foreach ($points as $i => $point) {
                if ((int)($point['waypoint_id'] ?? 0) === $waypointId) {
                    $endIndex = $i;
                    $found = true;
                    break;
                }
            }
            if (!$found) {
                return null;
            }
        }

        if ($startIndex >= $endIndex) {
            return null;
        }

        $lat = (float)$shipment['current_lat'];
        $lng = (float)$shipment['current_lng'];

        // Find the closest point only among the current and next route segments.
        $best = null;
        $lastSegment = min($endIndex - 1, $startIndex + 1);

        for ($i = $startIndex; $i <= $lastSegment; $i++) {
            $a = $points[$i];
            $b = $points[$i + 1];

            $meanLat = deg2rad(($lat + (float)$a['latitude'] + (float)$b['latitude']) / 3.0);
            $scaleX = max(0.01, cos($meanLat));
            $ax = (float)$a['longitude'] * $scaleX;
            $ay = (float)$a['latitude'];
            $bx = (float)$b['longitude'] * $scaleX;
            $by = (float)$b['latitude'];
            $px = $lng * $scaleX;
            $py = $lat;
            $dx = $bx - $ax;
            $dy = $by - $ay;
            $denom = $dx * $dx + $dy * $dy;
            $t = $denom > 0.0
                ? max(0.0, min(1.0, (($px - $ax) * $dx + ($py - $ay) * $dy) / $denom))
                : 0.0;

            $projLat = (float)$a['latitude'] + $t * ((float)$b['latitude'] - (float)$a['latitude']);
            $projLng = (float)$a['longitude'] + $t * ((float)$b['longitude'] - (float)$a['longitude']);
            $offRoute = $this->distanceKm($lat, $lng, $projLat, $projLng);

            if ($best === null || $offRoute < $best['off_route']) {
                $best = [
                    'index' => $i,
                    't' => $t,
                    'lat' => $projLat,
                    'lng' => $projLng,
                    'off_route' => $offRoute,
                ];
            }
        }

        if ($best === null || $best['off_route'] > 120.0) {
            return null;
        }

        $i = $best['index'];
        $t = $best['t'];
        $a = $points[$i];
        $b = $points[$i + 1];
        $segmentKm = $this->distanceKm(
            (float)$a['latitude'],
            (float)$a['longitude'],
            (float)$b['latitude'],
            (float)$b['longitude']
        );
        $remainingOnSegment = max(0.0, (1.0 - $t) * $segmentKm);
        $travel = max(0.0, $distanceKm);
        $newLat = $best['lat'];
        $newLng = $best['lng'];
        $heading = $this->bearing(
            (float)$a['latitude'],
            (float)$a['longitude'],
            (float)$b['latitude'],
            (float)$b['longitude']
        );
        $routeSequence = (int)$a['sequence'];
        $routeTravelled = 0.0;

        for ($j = 0; $j < $i; $j++) {
            $routeTravelled += $this->distanceKm(
                (float)$points[$j]['latitude'],
                (float)$points[$j]['longitude'],
                (float)$points[$j + 1]['latitude'],
                (float)$points[$j + 1]['longitude']
            );
        }
        $routeTravelled += max(0.0, $segmentKm - $remainingOnSegment);

        while (true) {
            $a = $points[$i];
            $b = $points[$i + 1];
            $segmentKm = $this->distanceKm(
                (float)$a['latitude'],
                (float)$a['longitude'],
                (float)$b['latitude'],
                (float)$b['longitude']
            );

            $t = $i === $best['index'] ? $best['t'] : 0.0;
            $available = max(0.0, (1.0 - $t) * $segmentKm);

            if ($travel <= $available || $i + 1 >= $endIndex) {
                $fraction = $segmentKm > 0.0
                    ? min(1.0, $t + ($travel / $segmentKm))
                    : 1.0;

                $angular = $segmentKm / self::EARTH_RADIUS_KM;
                $bearingRad = deg2rad($heading);
                $startLatRad = deg2rad((float)$a['latitude']);
                $startLngRad = deg2rad((float)$a['longitude']);
                $step = $angular * $fraction;

                $latRad = asin(
                    sin($startLatRad) * cos($step)
                    + cos($startLatRad) * sin($step) * cos($bearingRad)
                );
                $lngRad = $startLngRad + atan2(
                    sin($bearingRad) * sin($step) * cos($startLatRad),
                    cos($step) - sin($startLatRad) * sin($latRad)
                );

                $newLat = rad2deg($latRad);
                $newLng = fmod(rad2deg($lngRad) + 540.0, 360.0) - 180.0;
                $routeSequence = (int)$a['sequence'];
                $routeTravelled += min($travel, $available);
                $travel = 0.0;
                break;
            }

            $travel -= $available;
            $routeTravelled += $available;
            $i++;
            $routeSequence = (int)$points[$i]['sequence'];
            $heading = $this->bearing(
                (float)$points[$i]['latitude'],
                (float)$points[$i]['longitude'],
                (float)$points[$i + 1]['latitude'],
                (float)$points[$i + 1]['longitude']
            );
        }

        $total = 0.0;
        for ($j = 0; $j < count($points) - 1; $j++) {
            $total += $this->distanceKm(
                (float)$points[$j]['latitude'],
                (float)$points[$j]['longitude'],
                (float)$points[$j + 1]['latitude'],
                (float)$points[$j + 1]['longitude']
            );
        }

        $target = $points[$endIndex];
        $atTarget = $this->distanceKm(
            $newLat,
            $newLng,
            (float)$target['latitude'],
            (float)$target['longitude']
        ) <= 0.01;

        if ($atTarget) {
            $newLat = (float)$target['latitude'];
            $newLng = (float)$target['longitude'];
            $routeSequence = (int)$target['sequence'];
            $routeTravelled = 0.0;
            for ($j = 0; $j < $endIndex; $j++) {
                $routeTravelled += $this->distanceKm(
                    (float)$points[$j]['latitude'],
                    (float)$points[$j]['longitude'],
                    (float)$points[$j + 1]['latitude'],
                    (float)$points[$j + 1]['longitude']
                );
            }
        }

        return [
            'lat' => $newLat,
            'lng' => $newLng,
            'heading' => $heading,
            'total' => $total,
            'travelled' => min($total, $routeTravelled),
            'remaining' => max(0.0, $total - $routeTravelled),
            'route_sequence' => $routeSequence,
            'at_target' => $atTarget,
        ];
    }
    private function arriveAtTarget(
        array $shipment,
        array $control,
        ?array $waypoint
    ): array {
        $shipmentId = (int)$shipment['id'];

        $targetLat = $waypoint
            ? (float)$waypoint['latitude']
            : (float)$shipment['destination_lat'];

        $targetLng = $waypoint
            ? (float)$waypoint['longitude']
            : (float)$shipment['destination_lng'];

        $this->db->beginTransaction();

        try {
            if ($waypoint) {
                $waypointId = (int)$waypoint['id'];

                $updateWaypoint = $this->db->prepare(
                    'UPDATE shipment_waypoints
                     SET status = :status,
                         arrival_at = COALESCE(arrival_at, CURRENT_TIMESTAMP),
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                );

                $updateWaypoint->execute([
                    ':status' => 'arrived',
                    ':id' => $waypointId,
                ]);

                $event = $this->db->prepare(
                    'INSERT INTO tracking_events
                     (shipment_id, status, title, description, location)
                     VALUES
                     (:shipment_id, :status, :title, :description, :location)'
                );

                $event->execute([
                    ':shipment_id' => $shipmentId,
                    ':status' => 'arrived',
                    ':title' => 'Arrived at waypoint',
                    ':description' => 'Shipment has arrived at the next scheduled waypoint and is awaiting departure.',
                    ':location' => $waypoint['name'],
                ]);

                $next = $this->db->prepare(
                    'SELECT *
                     FROM shipment_waypoints
                     WHERE shipment_id = :shipment_id
                       AND sequence > :sequence
                     ORDER BY sequence ASC
                     LIMIT 1'
                );

                $next->execute([
                    ':shipment_id' => $shipmentId,
                    ':sequence' => (int)$waypoint['sequence'],
                ]);

                $nextWaypoint = $next->fetch();

                $controlUpdate = $this->db->prepare(
                    'UPDATE tracking_controls
                     SET is_running = 0,
                         current_waypoint_id = :current_waypoint,
                         next_waypoint_id = :next_waypoint,
                         paused_reason = :reason,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                );

                $controlUpdate->execute([
                    ':current_waypoint' => $waypointId,
                    ':next_waypoint' => $nextWaypoint
                        ? (int)$nextWaypoint['id']
                        : null,
                    ':reason' => 'Arrived at waypoint; awaiting departure.',
                    ':shipment_id' => $shipmentId,
                ]);

                $shipmentUpdate = $this->db->prepare(
                    'UPDATE shipments
                     SET current_lat = :lat,
                         current_lng = :lng,
                         speed = 0,
                         status = :status,
                         last_update = CURRENT_TIMESTAMP,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                );

                $shipmentUpdate->execute([
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                    ':status' => 'on_hold',
                    ':id' => $shipmentId,
                ]);
            } else {
                $this->db->prepare(
                    'UPDATE shipments
                     SET current_lat = :lat,
                         current_lng = :lng,
                         speed = 0,
                         distance_remaining = 0,
                         distance_travelled = distance_total,
                         status = :status,
                         eta = NULL,
                         last_update = CURRENT_TIMESTAMP,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                )->execute([
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                    ':status' => 'delivered',
                    ':id' => $shipmentId,
                ]);

                $this->db->prepare(
                    'UPDATE tracking_controls
                     SET is_running = 0,
                         paused_reason = NULL,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                )->execute([
                    ':shipment_id' => $shipmentId,
                ]);

                $this->db->prepare(
                    'INSERT INTO tracking_positions
                     (shipment_id, latitude, longitude, speed, heading)
                     VALUES (:shipment_id, :lat, :lng, 0, 0)'
                )->execute([
                    ':shipment_id' => $shipmentId,
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                ]);

                $this->db->prepare(
                    'INSERT INTO tracking_events
                     (shipment_id, status, title, description, location)
                     VALUES
                     (:shipment_id, :status, :title, :description, :location)'
                )->execute([
                    ':shipment_id' => $shipmentId,
                    ':status' => 'delivered',
                    ':title' => 'Shipment delivered',
                    ':description' => 'Shipment has reached its final destination.',
                    ':location' => $shipment['destination'],
                ]);
            }

            $this->db->commit();
        } catch (\Throwable $e) {
            if ($this->db->inTransaction()) {
                $this->db->rollBack();
            }

            throw $e;
        }

        return $this->state($shipmentId);
    }

    private function getShipment(int $shipmentId): ?array
    {
        $stmt = $this->db->prepare(
            'SELECT *
             FROM shipments
             WHERE id = :id
             LIMIT 1'
        );

        $stmt->execute([':id' => $shipmentId]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function getControl(int $shipmentId): ?array
    {
        $stmt = $this->db->prepare(
            'SELECT *
             FROM tracking_controls
             WHERE shipment_id = :shipment_id
             LIMIT 1'
        );

        $stmt->execute([':shipment_id' => $shipmentId]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function getNextWaypoint(
        int $shipmentId,
        array $control
    ): ?array {
        if (!empty($control['next_waypoint_id'])) {
            $stmt = $this->db->prepare(
                'SELECT *
                 FROM shipment_waypoints
                 WHERE id = :id
                 LIMIT 1'
            );

            $stmt->execute([
                ':id' => (int)$control['next_waypoint_id'],
            ]);

            $row = $stmt->fetch();

            if ($row && $row['status'] !== 'completed') {
                return $row;
            }
        }

        $stmt = $this->db->prepare(
            'SELECT *
             FROM shipment_waypoints
             WHERE shipment_id = :shipment_id
               AND status = :status
             ORDER BY sequence ASC
             LIMIT 1'
        );

        $stmt->execute([
            ':shipment_id' => $shipmentId,
            ':status' => 'pending',
        ]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function distanceKm(
        float $lat1,
        float $lng1,
        float $lat2,
        float $lng2
    ): float {
        $lat1Rad = deg2rad($lat1);
        $lat2Rad = deg2rad($lat2);
        $deltaLat = deg2rad($lat2 - $lat1);
        $deltaLng = deg2rad($lng2 - $lng1);

        $a = sin($deltaLat / 2) ** 2
            + cos($lat1Rad)
            * cos($lat2Rad)
            * sin($deltaLng / 2) ** 2;

        return self::EARTH_RADIUS_KM
            * 2
            * atan2(sqrt($a), sqrt(max(0.0, 1 - $a)));
    }

    private function bearing(
        float $lat1,
        float $lng1,
        float $lat2,
        float $lng2
    ): float {
        $lat1Rad = deg2rad($lat1);
        $lat2Rad = deg2rad($lat2);
        $deltaLng = deg2rad($lng2 - $lng1);

        $y = sin($deltaLng) * cos($lat2Rad);

        $x = cos($lat1Rad) * sin($lat2Rad)
            - sin($lat1Rad)
            * cos($lat2Rad)
            * cos($deltaLng);

        $bearing = rad2deg(atan2($y, $x));

        return fmod($bearing + 360.0, 360.0);
    }

    private function state(int $shipmentId): array
    {
        $shipment = $this->getShipment($shipmentId);

        if (!$shipment) {
            throw new RuntimeException('Shipment not found.');
        }

        $control = $this->getControl($shipmentId);

        return [
            'shipment_id' => $shipmentId,
            'tracking_number' => $shipment['tracking_number'],
            'latitude' => (float)$shipment['current_lat'],
            'longitude' => (float)$shipment['current_lng'],
            'current_lat' => (float)$shipment['current_lat'],
            'current_lng' => (float)$shipment['current_lng'],
            'speed' => (float)$shipment['speed'],
            'distance_total' => (float)$shipment['distance_total'],
            'distance_travelled' => (float)$shipment['distance_travelled'],
            'distance_remaining' => (float)$shipment['distance_remaining'],
            'eta' => $shipment['eta'],
            'status' => $shipment['status'],
            'tracking_mode' => $shipment['tracking_mode'],
            'is_running' => $control
                ? (int)$control['is_running']
                : 0,
        ];
    }
}
