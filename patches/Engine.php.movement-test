<?php
declare(strict_types=1);

namespace VibrantHub\Tracking;

use PDO;
use RuntimeException;

final class Engine
{
    private const EARTH_RADIUS_KM = 6371.0088;

    public function __construct(private PDO $db)
    {
    }

    public function tick(int $shipmentId): array
    {
        $shipment = $this->getShipment($shipmentId);

        if (!$shipment) {
            throw new RuntimeException('Shipment not found.');
        }

        $control = $this->getControl($shipmentId);

        if (!$control || (int)$control['is_running'] !== 1) {
            return $this->state($shipmentId);
        }

        $holdCheck = $this->db->prepare("SELECT id FROM shipment_holds WHERE shipment_id = :id AND status = 'active' AND mandatory = 1 LIMIT 1");
        $holdCheck->execute([":id" => $shipmentId]);
        if ($holdCheck->fetchColumn()) {
            return $this->state($shipmentId);
        }

        $speed = max(0.0, (float)$control['control_speed']);

        if ($speed <= 0) {
            return $this->state($shipmentId);
        }

        $now = microtime(true);

        $lastUpdate = $shipment['last_update']
            ? strtotime((string)$shipment['last_update'])
            : null;

        if ($lastUpdate === false || $lastUpdate === null) {
            $elapsedSeconds = 1.0;
        } else {
            $elapsedSeconds = max(0.1, min(60.0, time() - $lastUpdate));
        }

        $distanceKm = ($speed * $elapsedSeconds) / 3600.0;

        $nextWaypoint = $this->getNextWaypoint($shipmentId, $control);

        $targetLat = $nextWaypoint
            ? (float)$nextWaypoint['latitude']
            : (float)$shipment['destination_lat'];

        $targetLng = $nextWaypoint
            ? (float)$nextWaypoint['longitude']
            : (float)$shipment['destination_lng'];

        $currentLat = (float)$shipment['current_lat'];
        $currentLng = (float)$shipment['current_lng'];

        $remainingToTarget = $this->distanceKm(
            $currentLat,
            $currentLng,
            $targetLat,
            $targetLng
        );

        $routeMove = $this->moveAlongStoredRoute(
            $shipment,
            $control,
            $nextWaypoint,
            $distanceKm
        );

        if ($routeMove !== null && $routeMove['at_target']) {
            return $this->arriveAtTarget(
                $shipment,
                $control,
                $nextWaypoint
            );
        }

        if ($routeMove !== null) {
            $newLat = $routeMove['lat'];
            $newLng = $routeMove['lng'];
            $heading = $routeMove['heading'];
            $totalDistance = $routeMove['total'];
            $travelled = $routeMove['travelled'];
            $remaining = $routeMove['remaining'];
            $newRouteSequence = $routeMove['route_sequence'];
        } else {
            if ($remainingToTarget <= 0.01 || $distanceKm >= $remainingToTarget) {
                return $this->arriveAtTarget(
                    $shipment,
                    $control,
                    $nextWaypoint
                );
            }

            $fraction = min(1.0, $distanceKm / $remainingToTarget);
            $angularDistance = $remainingToTarget / self::EARTH_RADIUS_KM;
            $bearingRad = deg2rad($this->bearing($currentLat, $currentLng, $targetLat, $targetLng));
            $latRad = deg2rad($currentLat);
            $lngRad = deg2rad($currentLng);
            $step = $angularDistance * $fraction;
            $newLatRad = asin(
                sin($latRad) * cos($step)
                + cos($latRad) * sin($step) * cos($bearingRad)
            );
            $newLngRad = $lngRad + atan2(
                sin($bearingRad) * sin($step) * cos($latRad),
                cos($step) - sin($latRad) * sin($newLatRad)
            );
            $newLat = rad2deg($newLatRad);
            $newLng = fmod(rad2deg($newLngRad) + 540.0, 360.0) - 180.0;

            $heading = $this->bearing(
                $currentLat,
                $currentLng,
                $newLat,
                $newLng
            );

            $totalDistance = $this->distanceKm(
                (float)$shipment['origin_lat'],
                (float)$shipment['origin_lng'],
                (float)$shipment['destination_lat'],
                (float)$shipment['destination_lng']
            );

            $travelled = $this->distanceKm(
                (float)$shipment['origin_lat'],
                (float)$shipment['origin_lng'],
                $newLat,
                $newLng
            );

            $remaining = max(0.0, $totalDistance - $travelled);
            $newRouteSequence = null;
        }

        $etaSeconds = $speed > 0
            ? ($remaining / $speed) * 3600
            : 0;

        $eta = date(
            'Y-m-d H:i:s',
            time() + (int)round($etaSeconds)
        );

        $this->db->beginTransaction();

        try {
            $stmt = $this->db->prepare(
                'UPDATE shipments
                 SET current_lat = :lat,
                     current_lng = :lng,
                     speed = :speed,
                     distance_total = :total,
                     distance_travelled = :travelled,
                     distance_remaining = :remaining,
                     eta = :eta,
                     status = :status,
                     tracking_mode = :mode,
                     last_update = CURRENT_TIMESTAMP,
                     updated_at = CURRENT_TIMESTAMP
                 WHERE id = :id'
            );

            $stmt->execute([
                ':lat' => $newLat,
                ':lng' => $newLng,
                ':speed' => $speed,
                ':total' => $totalDistance,
                ':travelled' => $travelled,
                ':remaining' => $remaining,
                ':eta' => $eta,
                ':status' => 'in_transit',
                ':mode' => $control['tracking_mode'] ?: 'simulation',
                ':id' => $shipmentId,
            ]);

            $position = $this->db->prepare(
                'INSERT INTO tracking_positions
                 (shipment_id, latitude, longitude, speed, heading)
                 VALUES
                 (:shipment_id, :lat, :lng, :speed, :heading)'
            );

            $position->execute([
                ':shipment_id' => $shipmentId,
                ':lat' => $newLat,
                ':lng' => $newLng,
                ':speed' => $speed,
                ':heading' => $heading,
            ]);

            if ($newRouteSequence !== null) {
                $cursorStmt = $this->db->prepare(
                    'UPDATE tracking_controls
                     SET current_route_sequence = :seq,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                );
                $cursorStmt->execute([
                    ':seq' => $newRouteSequence,
                    ':shipment_id' => $shipmentId,
                ]);
            }

            $this->db->commit();
        } catch (\Throwable $e) {
            if ($this->db->inTransaction()) {
                $this->db->rollBack();
            }

            throw $e;
        }

        return $this->state($shipmentId);
    }

    /**
     * Move along stored route geometry without changing the database.
     * Returns null when no usable route exists, allowing legacy movement.
     */
    private function moveAlongStoredRoute(
        array $shipment,
        array $control,
        ?array $nextWaypoint,
        float $distanceKm
    ): ?array {
        $shipmentId = (int)($shipment['id'] ?? 0);

        $stmt = $this->db->prepare(
            'SELECT sequence, latitude, longitude, waypoint_id
             FROM shipment_route_points
             WHERE shipment_id = :shipment_id
             ORDER BY sequence ASC'
        );
        $stmt->execute([':shipment_id' => $shipmentId]);
        $points = $stmt->fetchAll(PDO::FETCH_ASSOC);

        if (count($points) < 2 || $distanceKm < 0.0) {
            return null;
        }

        foreach ($points as &$point) {
            $point['sequence'] = (int)$point['sequence'];
            $point['latitude'] = (float)$point['latitude'];
            $point['longitude'] = (float)$point['longitude'];
            $point['waypoint_id'] = isset($point['waypoint_id'])
                ? (int)$point['waypoint_id'] : null;
        }
        unset($point);

        $cursor = (int)($control['current_route_sequence'] ?? 0);
        $startIndex = 0;

        foreach ($points as $index => $point) {
            if ($point['sequence'] >= $cursor) {
                $startIndex = max(0, $index - 1);
                break;
            }
        }

        $endIndex = count($points) - 1;

        if ($nextWaypoint !== null && isset($nextWaypoint['id'])) {
            $matchedWaypoint = false;

            foreach ($points as $index => $point) {
                if ($point['waypoint_id'] === (int)$nextWaypoint['id']) {
                    $endIndex = $index;
                    $matchedWaypoint = true;
                    break;
                }
            }

            if (!$matchedWaypoint) {
                return null;
            }
        }
        if ($endIndex <= $startIndex) {
            $startIndex = 0;
            $endIndex = count($points) - 1;
        }

        $lat = (float)$shipment['current_lat'];
        $lng = (float)$shipment['current_lng'];
        $tickStartLat = $lat;
        $tickStartLng = $lng;
        $remainingMove = max(0.0, $distanceKm);
        $previousTravelled = max(
            0.0,
            (float)($shipment['distance_travelled'] ?? 0.0)
        );
        $heading = (float)($shipment['heading'] ?? 0.0);

        $segmentLengths = [];
        $cumulative = [$startIndex => 0.0];
        $geometryTotal = 0.0;

        for ($i = $startIndex; $i < $endIndex; $i++) {
            $length = $this->distanceKm(
                $points[$i]['latitude'],
                $points[$i]['longitude'],
                $points[$i + 1]['latitude'],
                $points[$i + 1]['longitude']
            );

            $segmentLengths[$i] = $length;
            $geometryTotal += $length;
            $cumulative[$i + 1] = $geometryTotal;
        }

        $storedTotal = (float)($shipment['distance_total'] ?? 0.0);
        $total = $storedTotal > 0.0 ? $storedTotal : $geometryTotal;

        if ($geometryTotal <= 0.000001 || $total <= 0.000001) {
            return null;
        }

        $radius = self::EARTH_RADIUS_KM;

        $destination = static function (
            float $fromLat,
            float $fromLng,
            float $bearingDeg,
            float $distance
        ) use ($radius): array {
            $angular = $distance / $radius;
            $bearing = deg2rad($bearingDeg);
            $lat1 = deg2rad($fromLat);
            $lng1 = deg2rad($fromLng);

            $sinLat2 = sin($lat1) * cos($angular)
                + cos($lat1) * sin($angular) * cos($bearing);
            $lat2 = asin(max(-1.0, min(1.0, $sinLat2)));

            $lng2 = $lng1 + atan2(
                sin($bearing) * sin($angular) * cos($lat1),
                cos($angular) - sin($lat1) * sin($lat2)
            );

            $outLng = fmod(rad2deg($lng2) + 540.0, 360.0) - 180.0;

            return [rad2deg($lat2), $outLng];
        };

        /*
         * Project onto each route segment using spherical cross-track
         * geometry, matching the great-circle movement used below.
         */
        $bestDistance = INF;
        $bestIndex = $startIndex;
        $bestAlong = 0.0;
        $bestLat = $points[$startIndex]['latitude'];
        $bestLng = $points[$startIndex]['longitude'];

        for ($i = $startIndex; $i < $endIndex; $i++) {
            $a = $points[$i];
            $b = $points[$i + 1];
            $segmentLength = $segmentLengths[$i] ?? 0.0;

            if ($segmentLength <= 0.000001) {
                continue;
            }

            $segmentBearing = deg2rad($this->bearing(
                $a['latitude'],
                $a['longitude'],
                $b['latitude'],
                $b['longitude']
            ));

            $distanceToStart = $this->distanceKm(
                $a['latitude'],
                $a['longitude'],
                $lat,
                $lng
            ) / $radius;

            $bearingToVehicle = deg2rad($this->bearing(
                $a['latitude'],
                $a['longitude'],
                $lat,
                $lng
            ));

            $difference = $bearingToVehicle - $segmentBearing;

            $alongAngle = atan2(
                sin($distanceToStart) * cos($difference),
                cos($distanceToStart)
            );

            $along = max(
                0.0,
                min($segmentLength, $alongAngle * $radius)
            );

            [$candidateLat, $candidateLng] = $destination(
                $a['latitude'],
                $a['longitude'],
                rad2deg($segmentBearing),
                $along
            );

            $offRoute = $this->distanceKm(
                $lat,
                $lng,
                $candidateLat,
                $candidateLng
            );

            if ($offRoute < $bestDistance) {
                $bestDistance = $offRoute;
                $bestIndex = $i;
                $bestAlong = $along;
                $bestLat = $candidateLat;
                $bestLng = $candidateLng;
            }
        }

        $movedThisTick = 0.0;

        /*
         * Move toward the route without teleporting. If the vehicle
         * cannot reach the route this tick, return its actual position.
         */
        if ($bestDistance > 0.001) {
            $step = min($remainingMove, $bestDistance);

            if ($step > 0.0) {
                $heading = $this->bearing($lat, $lng, $bestLat, $bestLng);
                [$lat, $lng] = $destination($lat, $lng, $heading, $step);
                $remainingMove -= $step;
                $movedThisTick += $step;
            }

            if ($bestDistance > $step + 0.001) {
                $travelled = min($total, $previousTravelled + $movedThisTick);

                return [
                    'lat' => $lat,
                    'lng' => $lng,
                    'heading' => $heading,
                    'total' => $total,
                    'travelled' => $travelled,
                    'remaining' => max(0.0, $total - $travelled),
                    'route_sequence' => $points[$bestIndex]['sequence'],
                    'at_target' => false,
                ];
            }

            $lat = $bestLat;
            $lng = $bestLng;
        }

        $routePosition = ($cumulative[$bestIndex] ?? 0.0) + $bestAlong;
        $index = $bestIndex;

        while ($index < $endIndex && $remainingMove > 0.000001) {
            $a = $points[$index];
            $b = $points[$index + 1];
            $segmentLength = $segmentLengths[$index] ?? 0.0;

            if ($segmentLength <= 0.000001) {
                $index++;
                continue;
            }

            $segmentStart = $cumulative[$index] ?? 0.0;
            $along = max(
                0.0,
                min($segmentLength, $routePosition - $segmentStart)
            );
            $available = max(0.0, $segmentLength - $along);

            if ($available <= 0.000001) {
                $index++;
                continue;
            }

            $step = min($remainingMove, $available);
            $heading = $this->bearing(
                $a['latitude'],
                $a['longitude'],
                $b['latitude'],
                $b['longitude']
            );

            [$lat, $lng] = $destination(
                $a['latitude'],
                $a['longitude'],
                $heading,
                $along + $step
            );

            $routePosition += $step;
            $remainingMove -= $step;
            $movedThisTick += $step;

            if ($step >= $available - 0.000001) {
                $index++;
            } else {
                break;
            }
        }

        $movedThisTick = $this->distanceKm($tickStartLat, $tickStartLng, $lat, $lng);
        $travelled = min($total, max(0.0, $previousTravelled + $movedThisTick));
        $remaining = max(0.0, $total - $travelled);
        $sequence = $points[min($index, $endIndex)]['sequence'];
        $atTarget = $index >= $endIndex;

        return [
            'lat' => $lat,
            'lng' => $lng,
            'heading' => $heading,
            'total' => $total,
            'travelled' => $travelled,
            'remaining' => $remaining,
            'route_sequence' => $sequence,
            'at_target' => $atTarget,
        ];
    }
    private function arriveAtTarget(
        array $shipment,
        array $control,
        ?array $waypoint
    ): array {
        $shipmentId = (int)$shipment['id'];

        $targetLat = $waypoint
            ? (float)$waypoint['latitude']
            : (float)$shipment['destination_lat'];

        $targetLng = $waypoint
            ? (float)$waypoint['longitude']
            : (float)$shipment['destination_lng'];

        $this->db->beginTransaction();

        try {
            if ($waypoint) {
                $waypointId = (int)$waypoint['id'];

                $updateWaypoint = $this->db->prepare(
                    'UPDATE shipment_waypoints
                     SET status = :status,
                         arrival_at = COALESCE(arrival_at, CURRENT_TIMESTAMP),
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                );

                $updateWaypoint->execute([
                    ':status' => 'arrived',
                    ':id' => $waypointId,
                ]);

                $event = $this->db->prepare(
                    'INSERT INTO tracking_events
                     (shipment_id, status, title, description, location)
                     VALUES
                     (:shipment_id, :status, :title, :description, :location)'
                );

                $event->execute([
                    ':shipment_id' => $shipmentId,
                    ':status' => 'arrived',
                    ':title' => 'Arrived at waypoint',
                    ':description' => 'Shipment has arrived at the next scheduled waypoint and is awaiting departure.',
                    ':location' => $waypoint['name'],
                ]);

                $next = $this->db->prepare(
                    'SELECT *
                     FROM shipment_waypoints
                     WHERE shipment_id = :shipment_id
                       AND sequence > :sequence
                     ORDER BY sequence ASC
                     LIMIT 1'
                );

                $next->execute([
                    ':shipment_id' => $shipmentId,
                    ':sequence' => (int)$waypoint['sequence'],
                ]);

                $nextWaypoint = $next->fetch();

                $controlUpdate = $this->db->prepare(
                    'UPDATE tracking_controls
                     SET is_running = 0,
                         current_waypoint_id = :current_waypoint,
                         next_waypoint_id = :next_waypoint,
                         paused_reason = :reason,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                );

                $controlUpdate->execute([
                    ':current_waypoint' => $waypointId,
                    ':next_waypoint' => $nextWaypoint
                        ? (int)$nextWaypoint['id']
                        : null,
                    ':reason' => 'Arrived at waypoint; awaiting departure.',
                    ':shipment_id' => $shipmentId,
                ]);

                $shipmentUpdate = $this->db->prepare(
                    'UPDATE shipments
                     SET current_lat = :lat,
                         current_lng = :lng,
                         speed = 0,
                         status = :status,
                         last_update = CURRENT_TIMESTAMP,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                );

                $shipmentUpdate->execute([
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                    ':status' => 'on_hold',
                    ':id' => $shipmentId,
                ]);
            } else {
                $this->db->prepare(
                    'UPDATE shipments
                     SET current_lat = :lat,
                         current_lng = :lng,
                         speed = 0,
                         distance_remaining = 0,
                         distance_travelled = distance_total,
                         status = :status,
                         eta = NULL,
                         last_update = CURRENT_TIMESTAMP,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE id = :id'
                )->execute([
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                    ':status' => 'delivered',
                    ':id' => $shipmentId,
                ]);

                $this->db->prepare(
                    'UPDATE tracking_controls
                     SET is_running = 0,
                         paused_reason = NULL,
                         updated_at = CURRENT_TIMESTAMP
                     WHERE shipment_id = :shipment_id'
                )->execute([
                    ':shipment_id' => $shipmentId,
                ]);

                $this->db->prepare(
                    'INSERT INTO tracking_positions
                     (shipment_id, latitude, longitude, speed, heading)
                     VALUES (:shipment_id, :lat, :lng, 0, 0)'
                )->execute([
                    ':shipment_id' => $shipmentId,
                    ':lat' => $targetLat,
                    ':lng' => $targetLng,
                ]);

                $this->db->prepare(
                    'INSERT INTO tracking_events
                     (shipment_id, status, title, description, location)
                     VALUES
                     (:shipment_id, :status, :title, :description, :location)'
                )->execute([
                    ':shipment_id' => $shipmentId,
                    ':status' => 'delivered',
                    ':title' => 'Shipment delivered',
                    ':description' => 'Shipment has reached its final destination.',
                    ':location' => $shipment['destination'],
                ]);
            }

            $this->db->commit();
        } catch (\Throwable $e) {
            if ($this->db->inTransaction()) {
                $this->db->rollBack();
            }

            throw $e;
        }

        return $this->state($shipmentId);
    }

    private function getShipment(int $shipmentId): ?array
    {
        $stmt = $this->db->prepare(
            'SELECT *
             FROM shipments
             WHERE id = :id
             LIMIT 1'
        );

        $stmt->execute([':id' => $shipmentId]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function getControl(int $shipmentId): ?array
    {
        $stmt = $this->db->prepare(
            'SELECT *
             FROM tracking_controls
             WHERE shipment_id = :shipment_id
             LIMIT 1'
        );

        $stmt->execute([':shipment_id' => $shipmentId]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function getNextWaypoint(
        int $shipmentId,
        array $control
    ): ?array {
        if (!empty($control['next_waypoint_id'])) {
            $stmt = $this->db->prepare(
                'SELECT *
                 FROM shipment_waypoints
                 WHERE id = :id
                 LIMIT 1'
            );

            $stmt->execute([
                ':id' => (int)$control['next_waypoint_id'],
            ]);

            $row = $stmt->fetch();

            if ($row && $row['status'] !== 'completed') {
                return $row;
            }
        }

        $stmt = $this->db->prepare(
            'SELECT *
             FROM shipment_waypoints
             WHERE shipment_id = :shipment_id
               AND status = :status
             ORDER BY sequence ASC
             LIMIT 1'
        );

        $stmt->execute([
            ':shipment_id' => $shipmentId,
            ':status' => 'pending',
        ]);

        $row = $stmt->fetch();

        return $row ?: null;
    }

    private function distanceKm(
        float $lat1,
        float $lng1,
        float $lat2,
        float $lng2
    ): float {
        $lat1Rad = deg2rad($lat1);
        $lat2Rad = deg2rad($lat2);
        $deltaLat = deg2rad($lat2 - $lat1);
        $deltaLng = deg2rad($lng2 - $lng1);

        $a = sin($deltaLat / 2) ** 2
            + cos($lat1Rad)
            * cos($lat2Rad)
            * sin($deltaLng / 2) ** 2;

        return self::EARTH_RADIUS_KM
            * 2
            * atan2(sqrt($a), sqrt(max(0.0, 1 - $a)));
    }

    private function bearing(
        float $lat1,
        float $lng1,
        float $lat2,
        float $lng2
    ): float {
        $lat1Rad = deg2rad($lat1);
        $lat2Rad = deg2rad($lat2);
        $deltaLng = deg2rad($lng2 - $lng1);

        $y = sin($deltaLng) * cos($lat2Rad);

        $x = cos($lat1Rad) * sin($lat2Rad)
            - sin($lat1Rad)
            * cos($lat2Rad)
            * cos($deltaLng);

        $bearing = rad2deg(atan2($y, $x));

        return fmod($bearing + 360.0, 360.0);
    }

    private function state(int $shipmentId): array
    {
        $shipment = $this->getShipment($shipmentId);

        if (!$shipment) {
            throw new RuntimeException('Shipment not found.');
        }

        $control = $this->getControl($shipmentId);

        return [
            'shipment_id' => $shipmentId,
            'tracking_number' => $shipment['tracking_number'],
            'latitude' => (float)$shipment['current_lat'],
            'longitude' => (float)$shipment['current_lng'],
            'current_lat' => (float)$shipment['current_lat'],
            'current_lng' => (float)$shipment['current_lng'],
            'speed' => (float)$shipment['speed'],
            'distance_total' => (float)$shipment['distance_total'],
            'distance_travelled' => (float)$shipment['distance_travelled'],
            'distance_remaining' => (float)$shipment['distance_remaining'],
            'eta' => $shipment['eta'],
            'status' => $shipment['status'],
            'tracking_mode' => $shipment['tracking_mode'],
            'is_running' => $control
                ? (int)$control['is_running']
                : 0,
        ];
    }
}
